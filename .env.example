# Acceso a la app (login global, igual que adams/uoc).
# En dev, si no se define, cae a "michel101". Obligatoria en producción.
ACCESS_PASSWORD=

# Pass adicional para /seed-examples, /api/seed/examples, /profiles/seed y
# /api/profiles/seed. Obligatoria en producción (sin ella, 503). En dev cae
# a "michel101" si falta.
SEED_PASSWORD=

# Supabase (Marketplace Vercel -> auto-provisiona estas vars).
# Si trabajas en local sin vercel env pull, configúralas aquí.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel AI Gateway. La API key se inyecta automáticamente en deploys.
# En local, generar con: vercel env pull
AI_GATEWAY_API_KEY=

# Modelo por defecto a través del Gateway. Cambiar sin redeploy si hace falta.
SUAAS_DEFAULT_MODEL=anthropic/claude-sonnet-4.6
SUAAS_REASONER_MODEL=anthropic/claude-opus-4.7

# Modelo de embeddings del RAG de Cerebro (opcional). Default si falta:
# openai/text-embedding-3-small.
SUAAS_EMBEDDING_MODEL=

# Modelo de generación de imagen para los retratos IA de perfiles (opcional).
# Default si falta: google/imagen-4.0-generate-001.
SUAAS_AVATAR_MODEL=

# Presupuesto diario de tokens en la ventana de 24h sobre gateway_usage
# (opcional). Sin configurar no hay límite local (el tope real sigue siendo
# el budget de la API key en el dashboard del AI Gateway).
SUAAS_DAILY_TOKEN_BUDGET=

# Necesaria para los crons diarios (/api/cron/keepalive, /api/cron/reaper).
# Vercel la envía como Authorization: Bearer en cada invocación programada;
# sin ella los handlers devuelven 401 y el cron no hace nada. Generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Contraseña de "Conceptos pendientes" en /gravity (opcional). Sin definir
# cae al valor histórico.
GRAVITY_PASSWORD=

# Contraseña de la vista interna (rentabilidad) de la landing /propuesta
# (opcional). Sin definir cae a "michel101".
LANDING_PASSWORD=

# Vercel Blob (auto al vincular el store al proyecto). Uploads de imagen,
# vídeo y audio; si falta, se hace fallback a data: URL.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=
