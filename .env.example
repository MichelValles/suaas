# Acceso a la app (login global, igual que adams/uoc).
# En dev, si no se define, cae a "michel101".
ACCESS_PASSWORD=

# Supabase (Marketplace Vercel -> auto-provisiona estas vars).
# Si trabajas en local sin vercel env pull, configúralas aquí.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel AI Gateway. La API key se inyecta automáticamente en deploys.
# En local, generar con: vercel env pull
AI_GATEWAY_API_KEY=

# Modelo por defecto a través del Gateway. Cambiar sin redeploy si hace falta.
SUAAS_DEFAULT_MODEL=anthropic/claude-sonnet-4.6
SUAAS_REASONER_MODEL=anthropic/claude-opus-4.7
